{
  "name": "foodie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server tests scripts .github *.ts *.json *.md docs index.html",
    "format:check": "prettier --check src shared server tests scripts .github *.ts *.json *.md docs index.html"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "cheerio": "^1.2.0",
    "chefkoch-api": "1.2.2",
    "express": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
