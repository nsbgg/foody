# Optional configuration reference. npm start does not load this file itself.
# Export these variables in your shell, or use:
# node --env-file=.env server/index.ts
HOST=127.0.0.1
PORT=4307
DATA_DIR=data
# Comma-separated additional server hostnames/IPs, without scheme, port or path.
# Loopback hosts are already allowed. Set this when sharing over LAN or a proxy.
ALLOWED_HOSTS=
# Public origin and stable WebAuthn relying-party hostname. Use HTTPS in production.
# For npm run dev, use http://localhost:5173 instead.
APP_ORIGIN=http://localhost:4307
WEBAUTHN_RP_ID=localhost
